{
  "name": "project-homepage",
  "engines": {
    "bun": "1.3.14",
    "npm": "⚠️️  【bun】 を使ってください",
    "pnpm": "⚠️️  【bun】 を使ってください",
    "yarn": "⚠️️  【bun】 を使ってください"
  },
  "scripts": {
    "all-check": "run-s check-code ws:check-code test",
    "check-code": "run-p -c lint spell-check",
    "commitlint": "commitlint --edit",
    "fix": "run-p fix:* -c",
    "fix:config": "eslint -c eslint.config.mjs \"./\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "lint": "run-p lint:* -c",
    "lint:config": "eslint -c eslint.config.mjs \"./\" --max-warnings 0",
    "lint:editorconfigChecker": "ec",
    "lint:pack": "fixpack --dryRun",
    "prepare": "husky",
    "spell-check": "cspell \"./config/**\" --no-progress",
    "test": "bun test",
    "ws:check-code": "manypkg exec bun check-code",
    "ws:fix": "manypkg exec bun fix",
    "ws:lint": "manypkg exec bun lint",
    "ws:spell-check": "manypkg exec bun spell-check",
    "ws:type-check": "manypkg exec bun type-check"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@happy-dom/global-registrator": "20.10.6",
    "@manypkg/cli": "0.25.1",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "cspell": "10.0.1",
    "editorconfig-checker": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-sc-all": "0.2.2",
    "eslint-config-sc-js": "0.2.2",
    "eslint-config-sc-ts": "0.2.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-import-resolver-typescript-bun": "0.0.104",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-sc-js": "0.3.0",
    "eslint-plugin-unicorn": "59.0.1",
    "fixpack": "4.0.0",
    "husky": "9.1.7",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module"
}
