{
  "name": "module-images-db",
  "version": "0.0.0",
  "module": "index.ts",
  "scripts": {
    "check-code": "run-p -c lint spell-check type-check",
    "fix": "run-s fix:config fix:pack fix:product-code fix:prettier",
    "fix:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \".\" --ignore-path ../../.prettierignore -w -u",
    "fix:product-code": "eslint \"src/*/*.ts{,x}\" \"src/**/*.ts{,x}\" --max-warnings 0 --fix",
    "image-add": "run-s imageAdd fix",
    "image-delete": "run-s imageDelete fix",
    "imageAdd": "bun run ./src/upload-image/index.ts",
    "imageDelete": "bun run ./src/delete-image/index.ts",
    "lint": "run-p -c \"lint:*\"",
    "lint:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0",
    "lint:editorconfig": "editorconfig-checker",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \".\" --ignore-path ../../.prettierignore -c -u",
    "lint:product-code": "eslint \"src/*/*.ts{,x}\" \"src/**/*.ts{,x}\" --max-warnings 0",
    "spell-check": "cspell \"./{src,config}/**\" --no-progress",
    "type-check": "tsc"
  },
  "dependencies": {
    "@google-cloud/storage": "7.21.0",
    "sharp": "0.35.3",
    "uuid": "14.0.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@tsconfig/bun": "1.0.10",
    "@types/bun": "1.3.14",
    "@types/uuid": "11.0.0",
    "cspell": "10.0.1",
    "editorconfig-checker": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-sc-all": "0.2.2",
    "eslint-config-sc-jest": "0.2.2",
    "eslint-config-sc-js": "0.2.2",
    "eslint-config-sc-ts": "0.2.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jsdoc": "63.0.13",
    "eslint-plugin-sc-js": "0.3.0",
    "eslint-plugin-sonarjs": "4.1.0",
    "eslint-plugin-unicorn": "59.0.1",
    "fixpack": "4.0.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "type": "module"
}
