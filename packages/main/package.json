{
  "name": "main",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build --mode client && vite build",
    "check-code": "npm-run-all -p lint spell-check type-check -c",
    "deploy": "$npm_execpath run build && wrangler pages deploy ./dist",
    "dev": "vite",
    "fix": "run-p fix:config fix:pack fix:product-code fix:prettier -c",
    "fix:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \".\" -w -u",
    "fix:product-code": "eslint \"app/*/*.ts{,x}\" \"app/**/*.ts{,x}\" --max-warnings 0 --fix",
    "lint": "run-p -c \"lint:*\" -c",
    "lint:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0",
    "lint:editorconfig": "editorconfig-checker",
    "lint:markup": "markuplint \"./app/**/*.{ts,tsx}\" -p -config ./markuplint.config.ts",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \".\" -c -u",
    "lint:product-code": "eslint \"app/*/*.ts{,x}\" \"app/**/*.ts{,x}\" --max-warnings 0",
    "log": "wrangler pages deployment tail",
    "preview": "wrangler pages dev ./dist",
    "spell-check": "cspell \"./{config,app}/**\" --no-progress",
    "test": "bun test --isolate",
    "type-check": "tsc"
  },
  "dependencies": {
    "@formkit/tempo": "1.1.0",
    "cms-types": "workspace:*",
    "hono": "4.12.29",
    "honox": "0.1.58",
    "js-cookie": "3.0.8",
    "module-images-db": "workspace:*",
    "ofetch": "1.5.1",
    "remeda": "2.39.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260710.1",
    "@eslint/eslintrc": "3.3.6",
    "@eslint/js": "9.39.5",
    "@hono/vite-build": "1.11.1",
    "@markuplint/jsx-parser": "4.18.3",
    "@markuplint/ml-config": "4.18.1",
    "@markuplint/react-spec": "4.18.0",
    "@tsconfig/bun": "1.0.10",
    "@tsconfig/vite-react": "8.0.6",
    "@types/bun": "1.3.14",
    "@types/js-cookie": "3.0.6",
    "@typescript-eslint/parser": "8.65.0",
    "cspell": "10.0.1",
    "editorconfig-checker": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-sc-all": "0.2.2",
    "eslint-config-sc-jest": "0.2.2",
    "eslint-config-sc-js": "0.2.2",
    "eslint-config-sc-react": "0.2.2",
    "eslint-config-sc-ts": "0.2.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "29.16.0",
    "eslint-plugin-jsdoc": "63.0.13",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sc-js": "0.3.0",
    "eslint-plugin-sonarjs": "4.1.0",
    "eslint-plugin-unicorn": "59.0.1",
    "fixpack": "4.0.0",
    "markuplint": "4.18.3",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.63.0",
    "vite": "8.1.4",
    "vite-tsconfig-paths": "6.1.1",
    "wrangler": "4.110.0"
  },
  "peerDependencies": {
    "typescript": "5.9.3"
  },
  "private": true,
  "type": "module"
}
