{
  "name": "service-main-h",
  "version": "0.0.0",
  "scripts": {
    "build": "vite build --mode client && vite build",
    "check-code": "npm-run-all -p lint spell-check type-check -c",
    "deploy": "$npm_execpath run build && wrangler pages deploy ./dist",
    "dev": "vite",
    "fix": "run-p -c \"fix:*\"",
    "fix:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" \"!pnpm-lock.yaml\" -w -u",
    "fix:product-code": "eslint \"app/*/*.ts{,x}\" \"app/**/*.ts{,x}\" --max-warnings 0 --fix",
    "lint": "run-p -c \"lint:*\"",
    "lint:config": "eslint -c eslint.config.js.mjs \"./\" --max-warnings 0",
    "lint:editorconfig": "editorconfig-checker",
    "lint:markup": "markuplint \"./app/**/*.{ts,tsx}\" -p -config ./markuplint.config.ts",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" \"!pnpm-lock.yaml\" -c -u",
    "lint:product-code": "eslint \"app/*/*.ts{,x}\" \"app/**/*.ts{,x}\" --max-warnings 0",
    "log": "wrangler pages deployment tail",
    "predeploy": "bun check-code && bun test",
    "preview": "wrangler pages dev ./dist",
    "spell-check": "cspell \"./{config,app}/**\" --no-progress",
    "type-check": "tsc"
  },
  "dependencies": {
    "@formkit/tempo": "0.1.1",
    "hono": "4.3.11",
    "honox": "0.1.18",
    "js-cookie": "3.0.8",
    "module-images-db": "workspace:*",
    "remeda": "2.39.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20240512.0",
    "@hono/vite-cloudflare-pages": "0.4.0",
    "@markuplint/jsx-parser": "4.5.0",
    "@markuplint/ml-config": "4.4.0",
    "@markuplint/react-spec": "4.3.0",
    "@tsconfig/vite-react": "3.0.2",
    "@types/bun": "1.3.14",
    "@types/js-cookie": "3.0.6",
    "eslint": "8.57.0",
    "eslint-config-sc-all": "0.0.5",
    "eslint-config-sc-jest": "0.0.5",
    "eslint-config-sc-react": "0.0.5",
    "eslint-config-sc-ts": "0.0.7",
    "eslint-plugin-jsdoc": "50.2.2",
    "eslint-plugin-sc-js": "0.0.5",
    "eslint-plugin-sonarjs": "1.0.4",
    "fixpack": "4.0.0",
    "markuplint": "4.18.3",
    "prettier": "3.9.5",
    "vite": "5.2.11",
    "vite-tsconfig-paths": "4.3.2",
    "wrangler": "4.110.0"
  },
  "peerDependencies": {
    "typescript": "5.4.4"
  },
  "private": true,
  "type": "module"
}
