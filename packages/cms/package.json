{
  "name": "cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check-code": "run-p -c lint spell-check type-check",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "fix": "run-s fix:config fix:pack fix:product-code fix:prettier",
    "fix:config": "cross-env NODE_OPTIONS=--no-deprecation eslint -c eslint.config.js.mjs \".\" --max-warnings 0 --fix",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \".\" -w -u",
    "fix:product-code": "cross-env NODE_OPTIONS=--no-deprecation eslint \"src/**/*.ts{,x}\" \"tests/**/*.ts\" --max-warnings 0 --fix",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "run-p -c \"lint:*\"",
    "lint:config": "cross-env NODE_OPTIONS=--no-deprecation eslint -c eslint.config.js.mjs \".\" --max-warnings 0",
    "lint:editorconfig": "editorconfig-checker",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \".\" -c -u",
    "lint:product-code": "cross-env NODE_OPTIONS=--no-deprecation eslint \"src/**/*.ts{,x}\" \"tests/**/*.ts\" --max-warnings 0",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "seed:gallery-areas": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedGalleryAreas/index.ts",
    "seed:gallery-tags": "cross-env NODE_OPTIONS=--no-deprecation payload run src/scripts/seedGalleryTags/index.ts",
    "spell-check": "cspell \"./{config,src,tests}/**\" --no-progress",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "type-check": "tsc",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && bun run build"
  },
  "dependencies": {
    "@better-auth/passkey": "1.7.2",
    "@delmaredigital/payload-better-auth": "0.13.0",
    "@payloadcms/db-vercel-postgres": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/storage-vercel-blob": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "better-auth": "1.7.2",
    "cms-types": "workspace:*",
    "cross-env": "10.1.0",
    "dotenv": "17.4.2",
    "graphql": "16.14.2",
    "next": "16.3.4",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.4",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@better-auth/core": "1.7.2",
    "@eslint/eslintrc": "3.3.7",
    "@eslint/js": "9.39.5",
    "@next/eslint-plugin-next": "16.3.4",
    "@playwright/test": "1.63.0",
    "@testing-library/react": "16.3.3",
    "@types/node": "22.20.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "@typescript-eslint/parser": "8.65.0",
    "@vitejs/plugin-react": "6.1.1",
    "cspell": "10.2.2",
    "editorconfig-checker": "6.1.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-config-sc-all": "0.2.2",
    "eslint-config-sc-js": "0.2.2",
    "eslint-config-sc-next": "0.2.2",
    "eslint-config-sc-react": "0.2.2",
    "eslint-config-sc-ts": "0.2.2",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsdoc": "64.3.5",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-sc-js": "0.3.0",
    "eslint-plugin-sonarjs": "4.2.0",
    "eslint-plugin-unicorn": "65.0.1",
    "fixpack": "4.0.0",
    "jsdom": "30.0.1",
    "npm-run-all2": "9.0.3",
    "prettier": "3.9.6",
    "tsx": "4.23.13",
    "typescript": "6.0.3",
    "typescript-eslint": "8.69.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.0"
  },
  "type": "module"
}
