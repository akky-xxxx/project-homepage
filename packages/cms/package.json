{
  "name": "cms",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "engines": {
    "node": "^18.20.2 || >=20.9.0",
    "pnpm": "^9 || ^10 || ^11"
  },
  "scripts": {
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "check-code": "run-p -c lint spell-check type-check",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "fix": "run-s fix:pack fix:product-code fix:prettier",
    "fix:pack": "fixpack",
    "fix:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" -w -u",
    "fix:product-code": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings 0 --fix",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "run-p -c \"lint:*\"",
    "lint:editorconfig": "editorconfig-checker",
    "lint:pack": "fixpack --dryRun",
    "lint:prettier": "prettier \"./*.{json,toml,yaml,yml}\" \"./**/*.{json,toml,yaml,yml}\" -c -u",
    "lint:product-code": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings 0",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "spell-check": "cspell \"./{config,src,tests}/**\" --no-progress",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "test": "bun run test:int && bun run test:e2e",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "type-check": "tsc"
  },
  "dependencies": {
    "@better-auth/passkey": "1.6.25",
    "@delmaredigital/payload-better-auth": "0.9.2",
    "@payloadcms/db-vercel-postgres": "3.86.0",
    "@payloadcms/next": "3.86.0",
    "@payloadcms/richtext-lexical": "3.86.0",
    "@payloadcms/ui": "3.86.0",
    "better-auth": "1.6.25",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "graphql": "^16.8.1",
    "next": "16.2.6",
    "payload": "3.86.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.6",
    "@playwright/test": "1.58.2",
    "@testing-library/react": "16.3.0",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "4.5.2",
    "cspell": "10.0.1",
    "editorconfig-checker": "6.1.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.2.6",
    "fixpack": "4.0.0",
    "jsdom": "28.0.0",
    "npm-run-all2": "9.0.2",
    "prettier": "3.9.5",
    "tsx": "4.22.4",
    "typescript": "5.7.3",
    "vite-tsconfig-paths": "6.0.5",
    "vitest": "4.0.18"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  },
  "type": "module"
}
