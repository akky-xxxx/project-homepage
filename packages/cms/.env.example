# Vercel の Neon 連携が自動発行する接頭辞付きの変数名。ローカルでは名前を合わせるだけでよい
DB_POSTGRES_URL=postgres://postgres:postgres@127.0.0.1:5432/cms

# secret は 32 文字以上が必須。`openssl rand -base64 32` で生成する
PAYLOAD_SECRET=YOUR_SECRET_HERE
BETTER_AUTH_SECRET=YOUR_BETTER_AUTH_SECRET_HERE

# passkey の rpID になるため、本番では固定のカスタムドメインを指定する
BETTER_AUTH_URL=http://localhost:3000

# サインアップを許可する唯一のメールアドレス。未設定ならサインアップは常に拒否される。
# 初期管理者の登録が済んだらこの環境変数を削除して再デプロイする。
# ローカルでは int テストのテストユーザーに合わせる
SIGN_UP_ALLOWED_EMAIL=example@example.com

# 画像の保存先。ローカル DB に接続している間は未設定でよく、その場合はローカルディスクに保存する。
# DB_POSTGRES_URL がローカル以外を指しているときは必須(未設定なら起動時にエラーになる)。
# 空文字はアダプタに無視されるため、設定するなら必ず値を入れる(空文字も起動時にエラーになる)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_YOUR_STORE_ID_YOUR_TOKEN
